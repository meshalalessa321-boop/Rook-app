# Meridian private configuration
# Copy to environment variables on your deployment host. Never commit real credentials.
MERIDIAN_ACCESS_TOKEN=replace-with-at-least-32-random-characters
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GITHUB_TOKEN=
GITHUB_ALLOWED_REPOS=meshalalessa321-boop/Rook-app
DATABASE_URL=sqlite:///./meridian.db
WORKER_ENABLED=true
WORKER_POLL_SECONDS=5
WORKER_MAX_TOOL_STEPS=10
MAX_COMPLETION_TOKENS=2500
MAX_DAILY_MODEL_CALLS=60
MAX_CHAT_TOOL_STEPS=5
